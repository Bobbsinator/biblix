#!/bin/sh
# Dual-Boot: Hardware-Uhr in Ortszeit wie Windows, sonst geht die Uhr nach jedem Wechsel falsch.
# Muss nach live-builds eigenem Schritt 8000-remove-adjtime-configuration laufen,
# der /etc/adjtime sonst wieder auf UTC setzt. (Live-System: Startparameter utc=no)
set -e
printf '0.0 0 0.0\n0\nLOCAL\n' > /etc/adjtime
