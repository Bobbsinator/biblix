#!/bin/sh
set -e
# Fehler beim Erneuern von Startdateien melden (Update-Protokoll und Journal), aber nicht abbrechen
biblix_lauf() {
    if ! ausgabe=$("$@" 2>&1); then
        echo "Biblix: WARNUNG: '$*' ist fehlgeschlagen. Details: journalctl -t biblix" >&2
        printf '%s\n' "$ausgabe" | tail -n 5 >&2
        printf '%s\n' "$ausgabe" | logger -t biblix 2>/dev/null || true
    fi
}
T=/usr/share/desktop-base/biblix-theme

# Taskleiste und Startmenue: S-Launcher statt Discover (nach jedem Plasma-Update erneut)
starter() {
    for f in /usr/share/plasma/plasmoids/org.kde.plasma.taskmanager/contents/config/main.xml \
             /usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml \
             /usr/share/plasma/plasmoids/org.kde.plasma.kicker/contents/config/main.xml; do
        [ -f "$f" ] && sed -i 's/org\.kde\.discover\.desktop/de.biblix.SLauncher.desktop/g' "$f"
    done
    return 0
}

# Bootmenue, Startbildschirm und Anmeldung im Biblix-Standard (Bibi Tech), solange der Nutzer noch nichts gewaehlt hat
system_standard() {
    [ -e /var/lib/biblix/design/sddm/hintergrund.png ] && return 1
    python3 - <<'EOF' | /usr/lib/biblix/biblix-design-system || true
import json, sys
sys.path.insert(0, "/usr/share/biblix/design/lib")
from biblix_design import kern
e = dict(kern.STANDARD)
p = kern.palette(e, "dunkel")
print(json.dumps({"palette": {k: p[k] for k in kern.FARBNAMEN}, "name": p["name"], "dunkel": True,
                  "hintergrund": e["hintergrund"], "bootmenue": True}))
EOF
    return 0
}

case "$1" in
    configure)
        update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme $T 100
        if [ -z "$2" ]; then
            update-alternatives --set desktop-theme $T
        fi
        starter
        /usr/lib/biblix/biblix-sperrbildschirm einrichten || true
        systemctl --global enable biblix-design-tagnacht.timer >/dev/null 2>&1 || true
        gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
        if ! system_standard; then
            # Nutzer hat schon ein Design: nur Bilder des Grund-Themas uebernehmen
            biblix_lauf update-initramfs -u
            if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
                biblix_lauf update-grub
            fi
        fi
        ;;
    triggered)
        starter
        /usr/lib/biblix/biblix-sperrbildschirm einrichten || true
        ;;
esac
exit 0
