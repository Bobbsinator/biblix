#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Erzeugte Systemteile entfernen; Debian-Standard fuer Bootmenue und Startbildschirm zurueck
    rm -f /etc/default/grub.d/zz-biblix-design.cfg /usr/share/sddm/themes/breeze/theme.conf.user
    if [ "$(plymouth-set-default-theme 2>/dev/null)" = biblix-aktuell ]; then
        plymouth-set-default-theme -r 2>/dev/null || true
    fi
    rm -rf /usr/share/plymouth/themes/biblix-aktuell /boot/grub/themes/biblix-aktuell
    if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
        update-grub >/dev/null 2>&1 || true
    fi
fi
if [ "$1" = purge ]; then
    rm -rf /var/lib/biblix/design
fi
exit 0
