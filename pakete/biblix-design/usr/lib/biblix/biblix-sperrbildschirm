                    x: modelData[0] * biblixB.s + versatz
                    y: modelData[1] * biblixB.s
                    width: modelData[2] * biblixB.s
                    height: 12 * biblixB.s
                    radius: height / 2
                    color: index % 2 === 0 ? Kirigami.Theme.highlightColor : Qt.lighter(Kirigami.Theme.highlightColor, 1.35)
                    opacity: 0
                    SequentialAnimation {
                        running: true
                        PauseAnimation { duration: 250 + biblixBalken.index * 140 }
                        ParallelAnimation {
                            NumberAnimation { target: biblixBalken; property: "versatz"; to: 0; duration: 420; easing.type: Easing.OutBack }
                            NumberAnimation { target: biblixBalken; property: "opacity"; to: 1; duration: 300 }
                        }
