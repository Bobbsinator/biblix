                width: 12 * biblixB.s
                height: 68 * biblixB.s
                radius: 3 * biblixB.s
                color: Kirigami.Theme.textColor
                opacity: 0
                NumberAnimation on opacity { to: 1; duration: 300; running: true }
                Connections {
                    target: biblixB
