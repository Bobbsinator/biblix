def anpassen_ui(text):
    anker_uhr = "            id: clock\n"
    anker_schatten = "            id: clockShadow\n"
    anker_nutzer = "        ListModel {\n            id: users\n"
    if not all(a in text for a in (anker_uhr, anker_schatten, anker_nutzer)) or "biblixSpruch" in text:
        return None
    text = text.replace(anker_uhr, anker_uhr + '            scale: config.biblixStil === "bibi" ? 1.4 : 1.0\n'
                                                 '            transformOrigin: Item.Bottom\n', 1)
    text = text.replace(anker_schatten, anker_schatten + "            scale: clock.scale\n"
                                                         "            transformOrigin: Item.Bottom\n", 1)
    block = BLOCK.replace("@SPRUECHE@", json.dumps(sprueche(), ensure_ascii=False))
    text = text.replace(anker_nutzer, block.lstrip("\n") + "\n" + anker_nutzer, 1)
    # Entsperren: erst die Balken wegfliegen lassen. Fehlt die Stelle (neue Plasma-Version),
    # entsperrt KDE wie gewohnt sofort, der Rest bleibt.
    anker_quit = "            if (authenticator.hadPrompt) {\n                Qt.quit();\n"
    if anker_quit in text:
        text = text.replace(anker_quit, "            if (authenticator.hadPrompt) {\n"
                                        "                try { if (biblixB.visible) { biblixNotAus.start(); biblixWeg.start(); return; } } catch (e) {}\n"
                                        "                Qt.quit();\n", 1)
    return text


def anpassen_config(text):
    anker = "  </group>"
    if anker not in text or "biblixStil" in text:
        return None
    eintrag = ('    <entry name="biblixStil" type="String">\n'
               '      <label>Biblix: bibi, terminal oder schlicht</label>\n'
               '      <default>bibi</default>\n'
               '    </entry>\n')
    return text.replace(anker, eintrag + anker, 1)


def einrichten():
    if not ORDNER.exists():
        return
    for datei in DATEIEN:
        if not (ORDNER / datei).exists() and not original(datei).exists():
            return
    for datei in DATEIEN:
        umleiten(datei)
    ui = anpassen_ui(original("LockScreenUi.qml").read_text(encoding="utf-8"))
    cfg = anpassen_config(original("config.xml").read_text(encoding="utf-8"))
    if ui is None or cfg is None:
        # Plasma hat sich geändert: KDE-Original verwenden
        for datei in DATEIEN:
            shutil.copy2(original(datei), ORDNER / datei)
        print("biblix-sperrbildschirm: Plasma-Version unbekannt, KDE-Sperrbildschirm bleibt")
        return
    (ORDNER / "LockScreenUi.qml").write_text(ui, encoding="utf-8")
    (ORDNER / "config.xml").write_text(cfg, encoding="utf-8")


def entfernen():
    for datei in DATEIEN:
        ziel = ORDNER / datei
        r = subprocess.run(["dpkg-divert", "--listpackage", str(ziel)], capture_output=True, text=True)
        if r.stdout.strip() == PAKET:
            ziel.unlink(missing_ok=True)
            subprocess.run(["dpkg-divert", "--quiet", "--package", PAKET, "--rename",
                            "--divert", str(original(datei)), "--remove", str(ziel)], check=True)


if __name__ == "__main__":
    {"einrichten": einrichten, "entfernen": entfernen}[sys.argv[1] if len(sys.argv) > 1 else "einrichten"]()
