#!/usr/bin/python3
"""Biblix-Sperrbildschirm: ergänzt den KDE-Sperrbildschirm (große Uhr, Bibi-Spruch, Terminal-Stil).

  biblix-sperrbildschirm einrichten   (postinst und Trigger nach Plasma-Updates)
  biblix-sperrbildschirm entfernen    (prerm): KDE-Original wiederherstellen

Die Originaldateien werden per dpkg-divert beiseitegelegt. Die Biblix-Fassung wird aus dem
Original erzeugt. Findet der Anpasser seine Ankerstellen nicht (neue Plasma-Version), bleibt
das KDE-Original unverändert im Einsatz.
"""
import json
import shutil
import subprocess
import sys
from pathlib import Path

ORDNER = Path("/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen")
DATEIEN = ["LockScreenUi.qml", "config.xml"]
SPRUECHE = Path("/usr/share/biblix/design/sprueche.txt")
PAKET = "biblix-design"


def original(datei):
    return ORDNER / (datei + ".biblix-original")


def umleiten(datei):
    ziel = ORDNER / datei
    r = subprocess.run(["dpkg-divert", "--listpackage", str(ziel)], capture_output=True, text=True)
    if r.stdout.strip() != PAKET:
        subprocess.run(["dpkg-divert", "--quiet", "--package", PAKET, "--rename",
                        "--divert", str(original(datei)), "--add", str(ziel)], check=True)


def sprueche():
    try:
        z = [s.strip() for s in SPRUECHE.read_text(encoding="utf-8").splitlines()]
        z = [s for s in z if s and not s.startswith("#")]
    except OSError:
        z = []
    return z or ["AUF BIBLIX GEHT DAS."]


BLOCK = '''
