                    ParallelAnimation {
                        id: biblixBalkenWeg
                        NumberAnimation { target: biblixBalken; property: "versatz"; to: 160 * biblixB.s; duration: 260 + biblixBalken.index * 40; easing.type: Easing.InCubic }
