<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="icon" type="String">
            <default>biblix</default>
        </entry>
        <!-- symbol (Logo) | bknopf (gelber B-Knopf, Taskleiste "Typenschild") -->
        <entry name="knopf" type="String"><default>symbol</default></entry>
        <entry name="knopfFarbe" type="String"><default>#378add</default></entry>
        <!-- rund (Typenschild) | kachel (Drei Zonen, Kopfzeile, Inseln) -->
        <entry name="knopfForm" type="String"><default>rund</default></entry>
        <!-- Inseln: Knopf sitzt auf einer eigenen Insel, Farben als JSON -->
        <entry name="insel" type="Bool"><default>false</default></entry>
        <entry name="farben" type="String"><default></default></entry>
        <entry name="stil" type="String">
            <label>panel = Menü über der Taskleiste, vollbild = großer Vollbild-Starter</label>
            <default>panel</default>
        </entry>
        <entry name="favorites" type="StringList">
            <default>preferred://browser,org.kde.dolphin.desktop,org.thunderbird.Thunderbird.desktop,com.rtosta.zapzap.desktop,org.kde.haruna.desktop,com.anthropic.claude.desktop,org.kde.konsole.desktop,systemsettings.desktop</default>
        </entry>
        <entry name="favoritesPortedToKAstats" type="Bool">
            <default>false</default>
        </entry>
    </group>
</kcfg>
