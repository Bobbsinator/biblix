# Biblix: Logo in der Mitte, Fortschrittsbalken darunter.
Window.SetBackgroundTopColor(0.027, 0.165, 0.212);
Window.SetBackgroundBottomColor(0.008, 0.035, 0.051);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 40, 1);

bar_w = 240;
track.image = Image("bar-track.png").Scale(bar_w, 6);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(cx - bar_w / 2, cy + logo.image.GetHeight() / 2 + 20, 1);
fill.base = Image("bar-fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(cx - bar_w / 2, cy + logo.image.GetHeight() / 2 + 20, 2);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 1) w = 1;
    fill.sprite.SetImage(fill.base.Scale(w, 6));
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- Passwortabfrage (LUKS)
prompt.sprite = Sprite();
dots.sprite = Sprite();
fun display_password_callback(prompt_text, bullets) {
    prompt.sprite.SetImage(Image.Text(prompt_text, 0.89, 0.95, 0.97));
    prompt.sprite.SetPosition(cx - prompt.sprite.GetImage().GetWidth() / 2, cy + 140, 10);
    s = "";
    for (i = 0; i < bullets; i++) s += "● ";
    dots.sprite.SetImage(Image.Text(s, 0.25, 0.82, 0.93));
    dots.sprite.SetPosition(cx - dots.sprite.GetImage().GetWidth() / 2, cy + 175, 10);
    prompt.sprite.SetOpacity(1);
    dots.sprite.SetOpacity(1);
}
fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    dots.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Meldungen (z. B. Dateisystempruefung)
msg.sprite = Sprite();
fun message_callback(text) {
    msg.sprite.SetImage(Image.Text(text, 0.56, 0.69, 0.75));
    msg.sprite.SetPosition(cx - msg.sprite.GetImage().GetWidth() / 2, Window.GetHeight() - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);
