#!/bin/sh
set -e
# Fehler beim Erneuern von Startdateien melden (Update-Protokoll und Journal), aber nicht abbrechen
biblix_lauf() {
    if ! ausgabe=$("$@" 2>&1); then
        echo "Biblix: WARNUNG: '$*' ist fehlgeschlagen. Details: journalctl -t biblix" >&2
        printf '%s\n' "$ausgabe" | tail -n 5 >&2
        printf '%s\n' "$ausgabe" | logger -t biblix 2>/dev/null || true
    fi
}
case "$1" in
    configure)
        visudo -cf /etc/sudoers.d/biblix >/dev/null
        # /etc/os-release muss auf die Biblix-Datei zeigen (live-build legt beim Bau eine Debian-Kopie an)
        if [ ! -L /etc/os-release ] || [ "$(readlink /etc/os-release)" != ../usr/lib/os-release ]; then
            ln -sfn ../usr/lib/os-release /etc/os-release
        fi
        if [ -z "$2" ]; then
            # Nur bei der Erstinstallation: spaeter trifft der Nutzer diese Wahl selbst
            for s in firewalld power-profiles-daemon switcheroo-control irqbalance cups; do
                systemctl enable "$s.service" >/dev/null 2>&1 || true
            done
            mkdir -p /var/lib/power-profiles-daemon
            [ -e /var/lib/power-profiles-daemon/state.ini ] || \
                printf '[State]\nCpuDriver=\nPlatformDriver=\nProfile=performance\n' > /var/lib/power-profiles-daemon/state.ini
            # Dual-Boot: Hardware-Uhr in Ortszeit wie Windows
            printf '0.0 0 0.0\n0\nLOCAL\n' > /etc/adjtime
        fi
        # Flatpak-Apps: Wayland erlauben (Electron-Apps nativ, schaerfer, volle Bildrate) und
        # fuer Steam mit NVIDIA: DLSS/Reflex in Proton und grosser Shader-Cache
        if command -v flatpak >/dev/null; then
            flatpak override --system --socket=wayland --env=ELECTRON_OZONE_PLATFORM_HINT=auto >/dev/null 2>&1 || true
            if lspci -n 2>/dev/null | grep -qE " 03[0-9a-f]{2}: 10de:"; then
                flatpak override --system --env=PROTON_ENABLE_NVAPI=1 --env=__GL_SHADER_DISK_CACHE_SIZE=12000000000                     --env=__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1 com.valvesoftware.Steam >/dev/null 2>&1 || true
            fi
            # Leistungs-Overlay (MangoHud) fuer Steam: Baustein passend zu Steams Laufzeit (wechselt mit Steam-Updates)
            if flatpak info --system com.valvesoftware.Steam >/dev/null 2>&1; then
                zweig=$(flatpak info --system --show-runtime com.valvesoftware.Steam 2>/dev/null | awk -F/ '{print $3}')
                if [ -n "$zweig" ] && ! flatpak info --system "org.freedesktop.Platform.VulkanLayer.MangoHud//$zweig" >/dev/null 2>&1; then
                    timeout 600 flatpak install --system -y --noninteractive flathub \
                        "org.freedesktop.Platform.VulkanLayer.MangoHud//$zweig" >/dev/null 2>&1 || true
                fi
                flatpak override --system --filesystem=xdg-config/MangoHud:ro com.valvesoftware.Steam >/dev/null 2>&1 || true
            fi
        fi
        # Neue Werte sofort wirksam machen (Rest beim naechsten Neustart)
        sysctl --system >/dev/null 2>&1 || true
        udevadm control --reload >/dev/null 2>&1 || true
        # HID-Rechte neu bewerten (Tastaturen ohne Rohzugriff; schon vergebene Rechte gelten bis zum Neustart)
        udevadm trigger --subsystem-match=hidraw --action=change >/dev/null 2>&1 || true
        firewall-cmd --reload >/dev/null 2>&1 || true
        biblix_lauf update-initramfs -u
        if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
            biblix_lauf update-grub
        fi
        ;;
esac
exit 0
