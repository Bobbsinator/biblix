# Biblix: Videos mit Bibiplexx oeffnen (Haruna als Ausweich), Musik mit Haruna
[Default Applications]
video/mp4=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/x-matroska=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/webm=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/x-msvideo=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/quicktime=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/mpeg=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/x-ms-wmv=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/mp2t=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/x-flv=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
video/ogg=de.biblix.Bibiplexx.desktop;org.kde.haruna.desktop;
audio/x-matroska=org.kde.haruna.desktop
# E-Mail-Links (mailto:) mit Thunderbird
x-scheme-handler/mailto=thunderbird.desktop
message/rfc822=thunderbird.desktop
# Webseiten mit dem Bibi Browser (Firefox als Ausweich)
text/html=de.biblix.BibiBrowser.desktop;firefox-esr.desktop;
x-scheme-handler/http=de.biblix.BibiBrowser.desktop;firefox-esr.desktop;
x-scheme-handler/https=de.biblix.BibiBrowser.desktop;firefox-esr.desktop;
application/xhtml+xml=de.biblix.BibiBrowser.desktop;firefox-esr.desktop;
