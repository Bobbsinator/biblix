<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Biblix</vendor>
  <action id="de.biblix.bootnext-windows">
    <description>Restart into Windows once</description>
    <description xml:lang="de">Einmal in Windows neu starten</description>
    <message>Authentication is required to restart into Windows.</message>
    <message xml:lang="de">Zum Neustart in Windows ist dein Passwort nötig.</message>
    <icon_name>system-reboot</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- Wer am PC sitzt, darf ohne Passwort ins andere System wechseln (wie beim Neustart selbst) -->
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/biblix/biblix-bootnext-windows</annotate>
  </action>
</policyconfig>
