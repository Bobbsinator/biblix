#!/usr/bin/python3
"""Biblix-Zeremonien: Filme zum Anmelden, Abmelden und Ausschalten (mpv, Vollbild, ohne Rahmen).

  biblix-zeremonie anmelden          nach dem Systemstart „hochfahren“, sonst „keynote“ (Autostart)
  biblix-zeremonie abmelden          Film, danach abmelden
  biblix-zeremonie herunterfahren    Film, danach ausschalten
  biblix-zeremonie windows           Film, danach Neustart in Windows (nur von biblix-neustart-windows)
  biblix-zeremonie zeigen NAME       nur den Film zeigen (hochfahren, keynote, abmelden, herunterfahren, windows)

Jede Taste überspringt den Film. Esc bricht Abmelden und Ausschalten ab (Rückgabe 4).
Einstellung „zeremonien“ in ~/.config/biblix/design.json: voll | kurz | aus. Bei aktivem Spielmodus: aus.
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DATEN = Path("/usr/share/biblix/zeremonien")
KONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "biblix" / "design.json"
MERKER = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "biblix" / "zeremonie-start"
ABGEBROCHEN = 4


def einstellung():
    try:
        return json.loads(KONFIG.read_text(encoding="utf-8")).get("zeremonien", "voll")
    except (OSError, ValueError):
        return "voll"


def spielmodus():
    if not shutil.which("gamemoded"):
        return False
    try:
        r = subprocess.run(["gamemoded", "-s"], capture_output=True, text=True, timeout=3)
        return "is active" in r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


def abspielen(name):
    """Spielt den Film; True = weiter (fertig oder übersprungen), False = abgebrochen (Esc)."""
    stufe = einstellung()
    datei = DATEN / f"{name}.mp4"
    if stufe == "aus" or spielmodus() or not datei.exists() or not shutil.which("mpv"):
        return True
    cmd = ["mpv", str(datei), "--fs", "--ontop", "--no-border", "--no-osc", "--no-osd-bar", "--osd-level=0",
           "--cursor-autohide=always", "--really-quiet", "--keep-open=no", "--no-config",
           "--title=Biblix-Zeremonie", "--x11-name=biblix-zeremonie", "--wayland-app-id=biblix-zeremonie",
           "--no-input-default-bindings", f"--input-conf={DATEN / 'eingabe.conf'}", "--volume=80"]
    if stufe == "kurz":
        cmd.append("--start=-3")
    try:
        r = subprocess.run(cmd, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return True
    return r.returncode != ABGEBROCHEN


def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return ""


def kde(methode):
    for q in ("qdbus6", "qdbus", "/usr/lib/qt6/bin/qdbus"):
        if shutil.which(q) or Path(q).exists():
            return subprocess.run([q, "org.kde.Shutdown", "/Shutdown", f"org.kde.Shutdown.{methode}"]).returncode
    return subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.Shutdown", "--object-path", "/Shutdown",
                           "--method", f"org.kde.Shutdown.{methode}"]).returncode


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "hilfe"):
        print(__doc__)
        return 0
    befehl = argv[0]
    if befehl == "anmelden":
        jetzt = boot_id()
        try:
            letzte = MERKER.read_text().strip()
        except OSError:
            letzte = ""
        MERKER.parent.mkdir(parents=True, exist_ok=True)
        MERKER.write_text(jetzt)
        abspielen("hochfahren" if jetzt != letzte else "keynote")
        return 0
    if befehl == "zeigen" and len(argv) > 1:
        abspielen(argv[1])
        return 0
    if befehl == "abmelden":
        return kde("logout") if abspielen("abmelden") else ABGEBROCHEN
    if befehl == "herunterfahren":
        return kde("logoutAndShutdown") if abspielen("herunterfahren") else ABGEBROCHEN
    if befehl == "windows":
        return 0 if abspielen("windows") else ABGEBROCHEN
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
